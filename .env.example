# ImageKit (already configured in Dokploy/Vercel)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Supabase (Project Settings → Data API / API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Strava API app (https://www.strava.com/settings/api) — one app per environment
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Public site origin, used for QR code URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin Agent (/admin/agent) — Vercel AI Gateway key, server-only ---
# Routes Claude Haiku / Gemini Flash / DeepSeek. On Vercel the gateway can also
# authenticate with the project's OIDC token; a key works everywhere.
VERCEL_AI_GATEWAY=

# --- Admin media uploads (event covers → ImageKit), server-only ---
# Public + private API keys from ImageKit → Developer options. The private key
# signs short-lived upload tokens on the server; it never reaches the browser.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# --- Newsletter tab (/admin/newsletter) — Resend, server-only ---
RESEND_API_KEY=
# Optional: sender (default "Yas Rise <news@mail.yasrise.run>") and the Resend
# segment id for the newsletter list (default: find/create "YRC Newsletter").
RESEND_NEWSLETTER_FROM=
RESEND_SEGMENT_ID=

# --- Token-free e2e test mode (pnpm test:e2e sets these itself) ---
# NEVER set on a deployed environment. See e2e/README.md.
# YRC_E2E=
# YRC_E2E_SECRET=
