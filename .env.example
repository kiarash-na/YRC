# ImageKit (already configured in Dokploy/Vercel)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Supabase (Project Settings → Data API / API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Strava API app (https://www.strava.com/settings/api) — one app per environment
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Public site origin, used for QR code URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
